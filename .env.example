DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DATABASE_URL=postgresql://user:password@host:5432/dbname
NEXTAUTH_SECRET=generate_a_random_secret_here
NEXTAUTH_URL=http://localhost:3000
# 豆包语音（端到端实时语音模型）
VOLC_APP_ID=your_doubao_speech_app_id
VOLC_ACCESS_TOKEN=your_doubao_speech_access_token
# 火山账号 AK/SK，只允许服务端读取，用于调用 StartVoiceChat
VOLC_ACCESS_KEY_ID=your_volc_access_key_id
VOLC_SECRET_ACCESS_KEY=your_volc_secret_access_key
# RTC 应用，用于生成进房 Token
VOLC_RTC_APP_ID=your_rtc_app_id
VOLC_RTC_APP_KEY=your_rtc_app_key
# 可选。生产环境定时清理过期练习数据时使用：Authorization: Bearer <secret>
CRON_SECRET=your_cron_secret_here
